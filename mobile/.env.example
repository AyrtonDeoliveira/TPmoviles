# Copiar como .env si necesitás forzar la URL del backend.
# El .env NO se sube al repo (solo se versiona este .env.example).
#
# En Expo, las variables que empiezan con EXPO_PUBLIC_ quedan disponibles
# en el código como process.env.EXPO_PUBLIC_...
# Van SOLO configuraciones públicas (una URL). Nada de claves privadas.

# Si se deja vacío/sin definir, la app deduce la IP de la PC desde el host de Expo.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000
