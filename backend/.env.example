# Copiar este archivo como .env y completar los valores reales.
# El .env NO se sube al repo (esta en .gitignore).

# Puerto donde escucha el backend
PORT=4000

# Entorno: development | production
NODE_ENV=development

# --- Supabase ---
# URL de la API (https://<ref>.supabase.co), NO la del panel
SUPABASE_URL=
# Service role / secret key: SOLO backend, nunca en la app movil
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de IA: Gemini (Semana 3) ---
IA_API_KEY=
# Modelo de Gemini a usar (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Tiempo maximo de una ejecucion de analisis (ms); al agotarse -> estado 'fallida'
IA_TIMEOUT_MS=60000

# --- Busqueda web para el analisis: Brave Search API (opcional) ---
# Sin esta key, el analisis sigue funcionando sin evidencia externa.
BRAVE_API_KEY=
BRAVE_TIMEOUT_MS=8000
