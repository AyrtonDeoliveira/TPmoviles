# Copiar este archivo como .env y completar los valores reales.
# El .env NO se sube al repo (esta en .gitignore).

# Puerto donde escucha el backend
PORT=4000

# Entorno: development | production
NODE_ENV=development

# --- Supabase ---
# URL de la API (https://<ref>.supabase.co), NO la del panel
SUPABASE_URL=
# Service role / secret key: SOLO backend, nunca en la app movil
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de IA (se va a probar Gemini; integracion en Semana 3) ---
IA_API_KEY=
# Tiempo maximo de una ejecucion de analisis (ms); al agotarse -> estado 'fallida'
IA_TIMEOUT_MS=60000
