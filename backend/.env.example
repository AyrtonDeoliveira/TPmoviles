# Copiar este archivo como .env y completar los valores reales.
# El .env NO se sube al repo (esta en .gitignore).

# Puerto donde escucha el backend
PORT=4000

# Entorno: development | production
NODE_ENV=development

# --- Supabase (se completan en la Semana 1-2) ---
# URL del proyecto de Supabase
SUPABASE_URL=
# Service role key: SOLO backend, nunca en la app movil
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de IA (a definir) ---
IA_API_KEY=
